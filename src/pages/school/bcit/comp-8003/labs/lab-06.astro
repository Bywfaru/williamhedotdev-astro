---
export const prerender = false;

import { SECRET_KEY } from 'astro:env/server';

const secret = Astro.url.searchParams.get('secret');

if (secret !== SECRET_KEY) return new Response(null, { status: 404 });
---

<main class="bg-gray-100 w-full min-h-screen p-10 flex flex-col gap-5">
  <div class="w-full max-w-4xl mx-auto flex flex-col gap-5">
    <input type="search" placeholder="Search files" class="rounded-full w-4/5 px-10 py-5 bg-gray-200" />

    <div class="w-full max-w-4xl mx-auto p-5 rounded-lg bg-white flex flex-col gap-5">
      <h1 class="text-4xl">Drive > Q2 2026 - Acceptable Use Review Policy Update</h1>

      <table class="w-full [&_th]:text-left [&_th]:border-b [&_th]:border-gray-500 [&_th]:p-2 [&_th]:bg-gray-400 [&_td]:border-b [&_td]:border-gray-500 [&_td]:p-2">
        <thead>
          <tr>
            <th>File name</th>
            <th>Last modified</th>
            <th>Owner</th>
          </tr>
        </thead>

        <tbody class="hover:[&>tr]:bg-gray-300 [&>tr:nth-child(even)]:bg-gray-200 [&>tr]:cursor-pointer">
          <tr>
            <td>AUP-v2.4-DRAFT-2026-Q2</td>
            <td>May 21, 2026</td>
            <td>John Smith</td>
          </tr>
          <tr>
            <td>Change-Summary-Q2-2026</td>
            <td>May 21, 2026</td>
            <td>John Smith</td>
          </tr>
          <tr>
            <td>AUP-v2.3-APPROVED-2025-Q4.pdf</td>
            <td>Nov 14, 2025</td>
            <td>John Smith</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</main>
